# AGRI-2 Environment Configuration
# Copy this file to .env and configure your credentials.

# Nexus AI API Configuration (OpenAI-compatible)
NEXUS_API_KEY=your_nexus_api_key_here
NEXUS_BASE_URL=https://nexusapi.navigatelabs.ai/v1
NEXUS_MODEL=gpt-5-nano

# Application Settings
APP_ENV=development
APP_DEFAULT_LANGUAGE=English

# Supabase PostgreSQL Database Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
